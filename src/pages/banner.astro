---
import '@fontsource/libertinus-serif/latin-400.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LinkedIn banner — Lucas Casco</title>
    <style is:global>
      :root {
        color-scheme: dark;
      }

      html,
      body {
        width: 1584px;
        height: 396px;
        margin: 0;
        overflow: hidden;
        background: #0e1012;
      }

      body {
        -webkit-font-smoothing: antialiased;
      }

      .banner {
        position: relative;
        width: 1584px;
        height: 396px;
        color: #e8e6e1;
      }

      .copy {
        position: absolute;
        top: 56px;
        right: 80px;
        text-align: right;
      }

      .role {
        margin: 0;
        font-family: 'Libertinus Serif', 'Linux Libertine', Georgia, serif;
        font-size: 32px;
        font-weight: 400;
        line-height: 1.2;
        color: #e8e6e1;
      }

      .claim {
        margin: 18px 0 0;
        font-family:
          system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          sans-serif;
        font-size: 64px;
        font-weight: 800;
        line-height: 1.04;
        letter-spacing: -0.025em;
        color: #e8e6e1;
      }

      .stack {
        position: absolute;
        right: 80px;
        bottom: 50px;
        display: flex;
        align-items: center;
        gap: 30px;
        margin: 0;
        padding: 0;
        list-style: none;
        color: #ffffff;
      }

      .stack li {
        display: flex;
        align-items: center;
      }

      .stack svg {
        display: block;
      }

      /* Astro injects this overlay in dev only; it must not appear in captures. */
      astro-dev-toolbar {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <main class="banner">
      <div class="copy">
        <p class="role">Fullstack Software Engineer</p>
        <h1 class="claim">TURNING COMPLEXITY INTO<br />WORKING SOFTWARE.</h1>
      </div>

