---
interface Props {
  id: string;
  num: string;
  title: string;
}

const { id, num, title } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section__head">
    <span class="section__num" aria-hidden="true">{num}</span>
    <h2 class="section__title" id={`${id}-title`}>{title}</h2>
  </div>
  <div class="section__body">
    <slot />
  </div>
</section>
