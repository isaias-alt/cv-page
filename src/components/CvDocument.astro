---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvSection from './CvSection.astro';
import DownloadIcon from './DownloadIcon.astro';
import { localePath, type CvContent, type Locale } from '../data/cv';

interface Props {
  content: CvContent;
}

const { content } = Astro.props;

const langLabels: Record<Locale, string> = {
  en: 'English',
  es: 'Español',
};

const currentPath = localePath[content.locale];
---

<BaseLayout
  htmlLang={content.htmlLang}
  title={content.meta.title}
  description={content.meta.description}
  canonicalPath={currentPath}
  ogLocale={content.meta.ogLocale}
  ogLocaleAlternate={content.meta.ogLocaleAlternate}
  skipToContent={content.labels.skipToContent}
>
  <div class="viewer">
    <div class="viewer-bar">
      <span class="viewer-label">CV</span>

      <div class="viewer-actions">
        <nav class="langs" aria-label={content.labels.languageSwitcher}>
          <a
            href={localePath.en}
            hreflang="en"
            aria-label={langLabels.en}
            aria-current={content.locale === 'en' ? 'page' : undefined}>EN</a
          >
          <a
            href={localePath.es}
            hreflang="es"
            aria-label={langLabels.es}
            aria-current={content.locale === 'es' ? 'page' : undefined}>ES</a
          >
        </nav>

        <span class="bar-sep" aria-hidden="true"></span>

        <a
          class="dl"
          href={content.download.href}
          download={content.download.filename}
          aria-label={content.labels.downloadAria}
        >
          {content.labels.download}
          <DownloadIcon size={11} />
        </a>
      </div>
    </div>

    <main id="main" class="doc">
      <article class="sheet" aria-label={content.labels.pageOne}>
        <header class="cv-head">
          <h1 class="cv-name">{content.profile.name}</h1>
          <p class="cv-contact">
            {
              content.profile.contact.map((item, index) => (
                <>
                  {index > 0 && <span class="cv-sep" aria-hidden="true"> · </span>}
                  <a
                    href={item.href}
                    title={item.label}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http')
                      ? 'me noopener noreferrer'
                      : undefined}
                  >
                    {item.value}
                  </a>
                </>
              ))
            }
          </p>
        </header>

        <p class="cv-summary">{content.profile.summary}</p>

        <CvSection title={content.labels.experience}>
          {
            content.experience.map((job) => (
              <div class="entry">
                <div class="entry__head">
                  <h3 class="entry__title">{job.title}</h3>
                  <p class="entry__dates">{job.period}</p>
                </div>

                {job.roles?.map((role) => (
                  <div class="subentry">
                    <div class="entry__head">
                      <h4 class="entry__subtitle">{role.title}</h4>
                      <p class="entry__dates">{role.period}</p>
                    </div>
                    <ul class="cv-list">
                      {role.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </div>
                ))}

                {job.bullets && (
                  <ul class="cv-list">
                    {job.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </CvSection>
      </article>

      <article class="sheet" aria-label={content.labels.pageTwo}>
        <CvSection title={content.labels.projects}>
          {
            content.projects.map((project) => (
              <div class="project">
                <h3 class="project__title">
                  {project.name} - {project.subtitle} (<a
                    class="project__link"
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer">{project.domain}</a
                  >)
                </h3>
                <ul class="cv-list">
                  {project.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
                <p class="project__stack">
                  {
                    content.projectStackBold ? (
                      <strong>
                        {content.labels.stackPrefix}: {project.stack}
                      </strong>
                    ) : (
                      <>
                        <strong>{content.labels.stackPrefix}:</strong> {project.stack}
                      </>
                    )
                  }
                </p>
              </div>
            ))
          }
        </CvSection>

        <CvSection title={content.labels.education}>
          {
            content.education.map((entry) => (
              <div class="edu">
                <h3 class="edu__title">{entry.institution}</h3>
                <ul class="cv-list">
                  <li>{entry.program}</li>
                </ul>
              </div>
            ))
          }
        </CvSection>

        <CvSection title={content.labels.stack}>
          <ul class="cv-list">
            {
              content.stack.map((group) => (
                <li>{group.label}: {group.items.join(', ')}</li>
              ))
            }
          </ul>
        </CvSection>

        <CvSection title={content.labels.languages}>
          <ul class="cv-list">
            {
              content.languages.map((language) => (
                <li>{language.name}: {language.level}</li>
              ))
            }
          </ul>
        </CvSection>

        <CvSection title={content.labels.references}>
          <ul class="cv-list">
            <li>{content.references}</li>
          </ul>
        </CvSection>
      </article>
    </main>

    <p class="viewer-foot">
      <a
        href={content.download.href}
        download={content.download.filename}>{content.labels.downloadCta}</a
      >
      <span aria-hidden="true"> · </span>
      <span>{content.labels.downloadMeta}</span>
    </p>
  </div>
</BaseLayout>
